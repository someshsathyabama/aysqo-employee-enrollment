# =============================================================================
# Aysqo Technologies - Monorepo Master Environment Configuration (.env.example)
# Duplicate this file as .env in production / staging
# =============================================================================

# Database Configuration (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aysqo_enrollment
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Backend Spring Profile
SPRING_PROFILES_ACTIVE=mysql

# Security & JWT Tokens
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Bootstrap Admin Account
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@aysqo.com
APP_ADMIN_PASSWORD=Admin@123

# Bootstrap HR Account
APP_HR_USERNAME=hr_manager
APP_HR_EMAIL=hr@aysqo.com
APP_HR_PASSWORD=Hr@123

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8080/api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
